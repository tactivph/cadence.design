  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tactivph/cadence.design.git"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "bootstrap": "^5.3.0",
    "@phosphor-icons/web": "^2.1.0",
    "apexcharts": "^5.10.3",
    "ng-apexcharts": "^2.5.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "publishConfig": {
